{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "build/*.mjs",
        ".vitepress/config.ts",
        "playwright.config.ts",
        "tests/e2e/*.ts",
        "tests/e2e/specs/**/*.spec.ts",
        "tests/setup/*.ts",
        "tests/load/*.mjs"
      ],
      "project": ["build/*.mjs", "*.ts", ".vitepress/*.ts", "tests/**/*.{ts,mjs}"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/i18n": {
      "project": ["src/**/*.ts"]
    },
    "apps/agent": {
      "project": ["src/**/*.ts"]
    },
    "apps/api": {
      "entry": ["src/testing.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/embed": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/media": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
