# LiveKit Cloud: `lk cloud auth && lk app env -w -d .env.local`
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
DATABASE_URL=postgres://cc:cc@localhost:5432/cc
# Shared secret between the agent worker and the API
INTERNAL_API_SECRET=change-me
# Comma-separated emails that become supervisor of the bootstrap tenant on first login
ADMIN_EMAILS=
BETTER_AUTH_SECRET=change-me-32-chars-minimum-please
# Google OAuth 2.0 client (redirect URI: http://localhost:4000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
