# Copy to `.env.local` and fill in the values. Every app loads `.env.local` from the
# repo root. Variables are grouped by consumer; within a group they are sorted.
# Full reference: docs/guide/getting-started.md

# --- LiveKit Cloud (all apps) — `lk cloud auth && lk app env -w -d .env.local` ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# --- API (apps/api) ---
# Comma-separated emails that become supervisor of their own tenant on first login
ADMIN_EMAILS=
# Random string, at least 32 characters
BETTER_AUTH_SECRET=change-me-32-chars-minimum-please
# Matches docker-compose.yml; `DATABASE_URL_TEST` optionally points the tests elsewhere
DATABASE_URL=postgres://cc:cc@localhost:5432/cc
# Google OAuth 2.0 web client; redirect URI http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared secret between the agent worker and the API's /api/internal endpoints
INTERNAL_API_SECRET=change-me

# Call recording (optional): audio-only LiveKit Egress to an S3-compatible bucket.
# Leave unset to disable recording (the desk button answers "recording_unavailable").
# RECORDING_S3_BUCKET=
# RECORDING_S3_REGION=
# RECORDING_S3_KEY=
# RECORDING_S3_SECRET=
# RECORDING_S3_ENDPOINT=            # only for non-AWS stores (MinIO, R2, ...)
# RECORDING_STUB=true               # dev/e2e: state machine + events, no Egress at all
# Port the API listens on
PORT=4000
# Origin of the web desk; also Better Auth's base URL (the desk proxies /api to the API)
WEB_ORIGIN=http://localhost:3000

# --- Agent worker (apps/agent) ---
# Where the worker reaches the API
API_ORIGIN=http://localhost:4000

# --- Web desk dev server (apps/web) ---
# Port of the API the Vite dev server proxies /api to, and the desk's own port
API_PORT=4000
WEB_PORT=3000

# --- Development only (ignored when NODE_ENV=production) ---
# Skip Google sign-in: every request runs as this user (add it to ADMIN_EMAILS too).
# The desk then gets a "Signed in as …" menu to become anyone else (one identity per
# browser profile) and the user's contact center is seeded with a demo team
# (Sam the supervisor, Alice, Bob and Carol) unless DEV_DEMO_TEAM=false.
# DEV_USER_EMAIL=you@example.com
# DEV_DEMO_TEAM=true
