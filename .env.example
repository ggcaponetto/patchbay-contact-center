# Self-hosted LiveKit server in dev mode (see README "Fully self-hosted setup").
# For LiveKit Cloud, replace with your project's URL/key/secret (`lk app env -w -d .env.local`).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Local OpenAI-compatible TTS server (e.g. Kokoro-FastAPI). Defaults shown.
LOCAL_TTS_URL=http://localhost:8880/v1
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE=af_heart

# Local OpenAI-compatible STT server (e.g. Speaches). Defaults shown.
LOCAL_STT_URL=http://localhost:8000/v1
LOCAL_STT_MODEL=Systran/faster-whisper-small

# Local LLM served by Ollama. Defaults shown.
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma4:e4b
